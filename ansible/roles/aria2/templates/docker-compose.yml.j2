version: "3.8"

services:
  aria2:
    image: p3terx/aria2-pro:latest
    container_name: aria2
    restart: unless-stopped
    ports:
      - "{{ aria2_rpc_port }}:6800"
      - "6888:6888"
      - "6888:6888/udp"
    environment:
      - PUID={{ aria2_puid }}
      - PGID={{ aria2_pgid }}
      - RPC_SECRET={{ vault.media.aria2_rpc_secret }}
      - RPC_PORT=6800
      - LISTEN_PORT=6888
      - DISK_CACHE=64M
      - IPV6_MODE=false
    volumes:
      - "{{ aria2_config_path }}:/config"
      - "{{ aria2_download_path }}:/downloads"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  ariang:
    image: p3terx/ariang:latest
    container_name: ariang
    restart: unless-stopped
    ports:
      - "{{ aria2_webui_port }}:6880"
    environment:
      - PUID={{ aria2_puid }}
      - PGID={{ aria2_pgid }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

DATABASE_URL=postgresql+asyncpg://{{ mailbot_database_user }}:{{ vault.database.mailbot_user_pw }}@{{ mailbot_database_host }}:{{ mailbot_database_port }}/{{ mailbot_database_name }}
GMAIL_ACCOUNTS='[{"email": "{{ vault.mailbot.gmail_email }}", "credentials_json": "{{ vault.mailbot.gmail_credentials_json }}"}]'
OLLAMA_URL={{ mailbot_ollama_url }}
DEFAULT_MODEL={{ mailbot_default_model }}
BATCH_SIZE={{ mailbot_batch_size }}
SLEEP_BETWEEN_BATCHES={{ mailbot_sleep_between_batches }}
PROMETHEUS_PORT={{ mailbot_prometheus_port }}
LOG_LEVEL={{ mailbot_log_level }}
DRY_RUN={{ mailbot_dry_run | lower }}

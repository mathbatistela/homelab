--- /dev/null
+++ b/src/tools/tags/update-tag/index.ts
@@ -0,0 +1,31 @@
+import { successWithJson, errorFromCatch } from '../../../utils/response.js';
+import { updateTag } from '../../../actual-api.js';
+
+export const schema = {
+  name: 'update-tag',
+  description: 'Update an existing tag',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      id: { type: 'string', description: 'ID of the tag to update' },
+      name: { type: 'string', description: 'New name for the tag' },
+      color: { type: 'string', description: 'New color (e.g. "#ff0000")' },
+      description: { type: 'string', description: 'New description' },
+    },
+    required: ['id'],
+    additionalProperties: false,
+  },
+};
+
+export async function handler(args: { id: string; name?: string; color?: string; description?: string }): Promise<ReturnType<typeof successWithJson> | ReturnType<typeof errorFromCatch>> {
+  try {
+    const updateArgs: Record<string, unknown> = {};
+    if (args.name !== undefined) updateArgs.name = args.name;
+    if (args.color !== undefined) updateArgs.color = args.color;
+    if (args.description !== undefined) updateArgs.description = args.description;
+    await updateTag(args.id, updateArgs);
+    return successWithJson({ updated: true, id: args.id });
+  } catch (err) {
+    return errorFromCatch(err);
+  }
+}

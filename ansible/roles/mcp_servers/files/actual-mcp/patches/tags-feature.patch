+++ b/src/tools/tags/create-tag/index.ts
@@ -0,0 +1,26 @@
+import { successWithJson, errorFromCatch } from '../../../utils/response.js';
+import { createTag } from '../../../actual-api.js';
+
+export const schema = {
+  name: 'create-tag',
+  description: 'Create a new tag',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      name: { type: 'string', description: 'Name of the tag' },
+      color: { type: 'string', description: 'Optional hex color (e.g. "#ff0000")' },
+      description: { type: 'string', description: 'Optional description' },
+    },
+    required: ['name'],
+    additionalProperties: false,
+  },
+};
+
+export async function handler(args: { name: string; color?: string; description?: string }): Promise<ReturnType<typeof successWithJson> | ReturnType<typeof errorFromCatch>> {
+  try {
+    const id = await createTag({ tag: args.name, color: args.color || null, description: args.description || null });
+    return successWithJson({ id, name: args.name });
+  } catch (err) {
+    return errorFromCatch(err);
+  }
+}

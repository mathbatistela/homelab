global:
  scrape_interval: 15s
  external_labels:
    namespace: local

rule_files:
  - /etc/prometheus/recording-rules.yml
  - /etc/prometheus/alerting-rules.yml

alerting:
  alertmanagers:
    - scheme: http
      static_configs:
        - targets: ['alertmanager:9093']

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
        labels:
          host: infra

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']
        labels:
          host: infra

  - job_name: node-exporter
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          host: infra
{% for host in groups['monitored_nodes'] %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          host: {{ host }}
{% endfor %}

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
        labels:
          host: infra
{% for host in groups['docker_monitored'] %}
      - targets: ['{{ hostvars[host].ansible_host }}:9080']
        labels:
          host: {{ host }}
{% endfor %}

  - job_name: home-assistant
    static_configs:
      - targets: ['{{ hostvars['ha'].ansible_host }}:8123']
        labels:
          host: ha
    metrics_path: /api/prometheus
    authorization:
      credentials: "{{ vault.ha.prometheus_token }}"

{% for config in prometheus_scrape_configs_extra | default([]) %}
  - job_name: {{ config.job_name }}
    static_configs:
{% for static_config in config.static_configs %}
      - targets: [{% for target in static_config.targets %}'{{ target }}'{% if not loop.last %}, {% endif %}{% endfor %}]
{% endfor %}
    scrape_interval: {{ config.scrape_interval | default('30s') }}
    scrape_timeout: {{ config.scrape_timeout | default('10s') }}
{% endfor %}

PGHOST={{ tiao_web_db_host }}
PGPORT=5432
PGDATABASE={{ tiao_web_db_name }}
PGUSER={{ tiao_web_db_user }}
PGPASSWORD={{ vault.database.tiao_user_pw }}

# Generated once on the host and kept in the state dir, never in the repo or the
# vault. Losing it only logs everyone out; it is not a credential to anything.
DJANGO_SECRET_KEY={{ tiao_web_secret_key }}

# Behind Pangolin, which terminates TLS and forwards plain HTTP. Without the
# trusted origin Django rejects the admin login as a CSRF failure.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_ORIGINS={{ tiao_web_public_origin }}

#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
import sys
import textwrap
from pathlib import Path

try:
    import yaml
    _YAML_AVAILABLE = True
except ImportError:
    _YAML_AVAILABLE = False

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import app_manifest  # noqa: E402
from lib.app_manifest import REQUIRED_FIELDS, VALID_SERVICE_TYPES  # noqa: E402,F401

ROOT = Path(__file__).resolve().parent.parent
APPS_DIR = ROOT / "apps"
TEMPLATE_DIR = APPS_DIR / ".template"

VALID_HOSTS = None


def _load_yaml(path: Path) -> dict:
    if not _YAML_AVAILABLE:
        print("error: PyYAML is required. Run: pip install pyyaml", file=sys.stderr)
        sys.exit(1)
    with open(path) as f:
        return yaml.safe_load(f) or {}


def _load_network_hosts() -> set[str]:
    global VALID_HOSTS
    if VALID_HOSTS is not None:
        return VALID_HOSTS
    network_path = ROOT / "config" / "network.json"
    if not network_path.exists():
        return set()
    with open(network_path) as f:
        data = json.load(f)
    VALID_HOSTS = set(data.get("local_hosts", {}).keys()) | set(data.get("remote_hosts", {}).keys())
    return VALID_HOSTS


def _app_dirs() -> list[Path]:
    if not APPS_DIR.exists():
        return []
    return sorted(
        d for d in APPS_DIR.iterdir()
        if d.is_dir() and not d.name.startswith(".") and (d / "app.yml").exists()
    )


def _load_app_config(app_dir: Path) -> dict:
    data = _load_yaml(app_dir / "app.yml")
    return data.get("app", {})


def _format_finding(app_dir: Path, finding: app_manifest.Finding) -> str:
    """Render a shared Finding in this CLI's wording."""
    app = app_dir.name
    code = finding.code

    if code == app_manifest.MISSING_FIELD:
        return f"{app}/app.yml: missing required field 'app.{finding['field']}'"
    if code == app_manifest.SERVICES_NOT_MAPPING:
        return f"{app}/app.yml: 'app.services' must be a non-empty mapping"
    if code == app_manifest.SERVICE_NOT_MAPPING:
        return f"{app}/app.yml: service '{finding['service']}' must be a mapping"
    if code == app_manifest.SERVICE_MISSING_PORT:
        return f"{app}/app.yml: service '{finding['service']}' missing 'port'"
    if code == app_manifest.SERVICE_UNKNOWN_TYPE:
        return (
            f"{app}/app.yml: service '{finding['service']}' has unknown type "
            f"'{finding['type']}'"
            f" (expected one of: {', '.join(sorted(VALID_SERVICE_TYPES))})"
        )
    if code == app_manifest.HOST_NOT_IN_NETWORK:
        return (
            f"{app}/app.yml: 'homelab.host' is '{finding['host']}' "
            f"but that host is not in config/network.json"
        )
    if code == app_manifest.SERVICE_DIR_MISSING:
        return f"{app}: services/{finding['service']}/ directory not found"
    if code == app_manifest.SERVICE_DOCKERFILE_MISSING:
        return f"{app}: services/{finding['service']}/Dockerfile not found"
    if code == app_manifest.NO_DOCKERFILE:
        return f"{app}: no Dockerfile found (expected at root or under services/)"
    return f"{app}/app.yml: {code} {finding.data}"


def _validate_app(app_dir: Path, strict: bool = False) -> list[str]:
    app_yml = app_dir / "app.yml"

    if not app_yml.exists():
        return [f"{app_dir.name}: missing app.yml"]

    data = _load_yaml(app_yml)
    if "app" not in data:
        return [f"{app_dir.name}/app.yml: missing top-level 'app' key"]

    cfg = data["app"]

    findings = app_manifest.check_app_config(cfg, valid_hosts=_load_network_hosts())
    if strict:
        # Dockerfile presence is checked only here; validate_sources.py has
        # never done it. See lib/app_manifest.check_app_layout.
        findings.extend(app_manifest.check_app_layout(app_dir, cfg))

    return [_format_finding(app_dir, f) for f in findings]


def cmd_list(args: argparse.Namespace) -> int:
    app_dirs = _app_dirs()
    if not app_dirs:
        print("No apps found in apps/")
        return 0

    fmt = "{:<20} {:<10} {:<10} {:<30}"
    print(fmt.format("NAME", "VERSION", "HOST", "DESCRIPTION"))
    print("-" * 72)
    for app_dir in app_dirs:
        cfg = _load_app_config(app_dir)
        name = cfg.get("name", app_dir.name)
        version = cfg.get("version", "—")
        host = (cfg.get("homelab") or {}).get("host", "—")
        description = cfg.get("description", "")
        if len(description) > 30:
            description = description[:27] + "..."
        print(fmt.format(name, version, host, description))

    print(f"\n{len(app_dirs)} app(s) total")
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    app_dirs = _app_dirs()
    if not app_dirs:
        print("No apps found in apps/")
        return 0

    all_issues: list[str] = []
    for app_dir in app_dirs:
        all_issues.extend(_validate_app(app_dir, strict=args.strict))

    if all_issues:
        print(f"✗  {len(all_issues)} issue(s) found:")
        for issue in all_issues:
            print(f"   {issue}")
        return 1

    print(f"✓  All {len(app_dirs)} app(s) valid")
    return 0


def cmd_create(args: argparse.Namespace) -> int:
    name = args.name.lower().replace(" ", "-").replace("_", "-")
    dest = APPS_DIR / name

    if dest.exists():
        print(f"error: apps/{name}/ already exists", file=sys.stderr)
        return 1

    if not TEMPLATE_DIR.exists():
        print(f"error: template directory not found at {TEMPLATE_DIR}", file=sys.stderr)
        return 1

    multi = args.multi or _prompt_bool(f"Is '{name}' a multi-service app?", default=False)

    shutil.copytree(TEMPLATE_DIR, dest)

    app_yml_path = dest / "app.yml"
    content = app_yml_path.read_text()
    content = content.replace("my-app", name)
    app_yml_path.write_text(content)

    if multi:
        (dest / "Dockerfile").unlink(missing_ok=True)
        frontend_dir = dest / "services" / "frontend" / "src"
        api_dir = dest / "services" / "api" / "src"
        frontend_dir.mkdir(parents=True, exist_ok=True)
        api_dir.mkdir(parents=True, exist_ok=True)
        (dest / "services" / "frontend" / "Dockerfile").write_text(
            (TEMPLATE_DIR / "Dockerfile").read_text()
        )
        (dest / "services" / "api" / "Dockerfile").write_text(
            (TEMPLATE_DIR / "Dockerfile").read_text()
        )
        # The template compose builds a single service from the root Dockerfile
        # we just deleted — replace it with one service per services/ dir.
        (dest / "docker-compose.yml").write_text(MULTI_COMPOSE)
        # Keep app.yml in step with the layout, otherwise `validate --strict`
        # fails on the app we just scaffolded (it looks for services/<name>/).
        app_yml_path.write_text(_multi_service_app_yml(app_yml_path.read_text(), name))
        print(f"✓  Created multi-service app at apps/{name}/")
        print(f"   Edit apps/{name}/app.yml, then add your services under apps/{name}/services/")
    else:
        src_dir = dest / "src"
        src_dir.mkdir(exist_ok=True)
        print(f"✓  Created single-service app at apps/{name}/")
        print(f"   Edit apps/{name}/app.yml and apps/{name}/Dockerfile")

    return 0


# Mirrors apps/adhd-board/docker-compose.yml — the working multi-service app in
# this repo. Each service builds from its own services/<name>/Dockerfile.
MULTI_COMPOSE = """services:
  frontend:
    build:
      context: services/frontend
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=development
      - VITE_API_URL=http://localhost:5000
    depends_on:
      - api
    restart: unless-stopped

  api:
    build:
      context: services/api
    ports:
      - "5000:5000"
    environment:
      - PORT=5000
      - FRONTEND_URL=http://localhost:3000
    restart: unless-stopped
"""

# Replaces the template's single `app:` service. Ports match MULTI_COMPOSE.
_MULTI_SERVICES_BLOCK = """  services:
    frontend:
      # "frontend" | "backend" | "worker" | "proxy"
      type: frontend
      port: 3000
      image:
        # Final image name: ghcr.io/<owner>/<name>-<service>
        name: {name}-frontend
        tag: latest
      healthcheck:
        path: /
        interval: 30s

    api:
      type: backend
      port: 5000
      image:
        name: {name}-api
        tag: latest
      healthcheck:
        path: /health
        interval: 30s
"""


def _multi_service_app_yml(content: str, name: str) -> str:
    """Swap app.yml's single-service block for a frontend+api pair.

    Bounds come from the parsed YAML (key nodes carry source line numbers), not
    from pattern-matching the template text, and stop short of the comment block
    introducing the next key — so every surrounding comment survives.
    """
    if not _YAML_AVAILABLE:
        return content

    try:
        root = yaml.compose(content)
    except yaml.YAMLError:
        return content

    def _mapping_items(node):
        return node.value if isinstance(node, yaml.MappingNode) else []

    app_node = next(
        (v for k, v in _mapping_items(root)
         if isinstance(k, yaml.ScalarNode) and k.value == "app"),
        None,
    )
    if app_node is None:
        return content

    items = _mapping_items(app_node)
    index = next(
        (i for i, (k, _) in enumerate(items)
         if isinstance(k, yaml.ScalarNode) and k.value == "services"),
        None,
    )
    if index is None:
        return content

    lines = content.splitlines(keepends=True)
    start_line = items[index][0].start_mark.line

    if index + 1 < len(items):
        end_line = items[index + 1][0].start_mark.line
        # Leave any comment/blank lines that introduce the following key.
        while end_line - 1 > start_line:
            stripped = lines[end_line - 1].strip()
            if stripped and not stripped.startswith("#"):
                break
            end_line -= 1
    else:
        end_line = len(lines)

    block = _MULTI_SERVICES_BLOCK.format(name=name)
    return "".join(lines[:start_line]) + block + "".join(lines[end_line:])


def _prompt_bool(question: str, default: bool) -> bool:
    suffix = " [Y/n]" if default else " [y/N]"
    try:
        answer = input(question + suffix + " ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        return default
    if answer in ("y", "yes"):
        return True
    if answer in ("n", "no"):
        return False
    return default


def cmd_build(args: argparse.Namespace) -> int:
    app_dir = APPS_DIR / args.name
    if not app_dir.exists():
        print(f"error: apps/{args.name}/ not found", file=sys.stderr)
        return 1

    cfg = _load_app_config(app_dir)
    services = cfg.get("services", {})

    targets: list[tuple[str, Path]] = []

    services_subdir = app_dir / "services"
    if services_subdir.is_dir():
        for svc_name in services:
            if args.service and svc_name != args.service:
                continue
            svc_dir = services_subdir / svc_name
            if not (svc_dir / "Dockerfile").exists():
                print(f"warning: no Dockerfile found for service '{svc_name}', skipping")
                continue
            image = f"{args.name}-{svc_name}"
            targets.append((image, svc_dir))
    else:
        if args.service and args.service not in services:
            print(f"error: service '{args.service}' not found in app.yml", file=sys.stderr)
            return 1
        if (app_dir / "Dockerfile").exists():
            targets.append((args.name, app_dir))

    if not targets:
        print("error: no buildable targets found", file=sys.stderr)
        return 1

    registry = args.registry or ""
    tag = args.tag or "local"

    failed = False
    for image_name, context in targets:
        full_image = f"{registry}/{image_name}:{tag}" if registry else f"{image_name}:{tag}"
        cmd = ["docker", "build", "-t", full_image, str(context)]
        print(f"→  Building {full_image} …")
        result = subprocess.run(cmd)
        if result.returncode != 0:
            print(f"✗  Build failed for {image_name}")
            failed = True
        else:
            print(f"✓  Built {full_image}")

    return 1 if failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="homelab-apps",
        description="Manage homelab apps",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            examples:
              homelab-apps list
              homelab-apps validate
              homelab-apps validate --strict
              homelab-apps create my-app
              homelab-apps create my-app --multi
              homelab-apps build hello-world
              homelab-apps build adhd-board --service api
              homelab-apps build hello-world --tag v1.0.0
        """),
    )
    sub = parser.add_subparsers(dest="command", metavar="command")
    sub.required = True

    sub.add_parser("list", help="List all apps")

    p_validate = sub.add_parser("validate", help="Validate app configs")
    p_validate.add_argument(
        "--strict", action="store_true",
        help="Also check that Dockerfiles exist for declared services"
    )

    p_create = sub.add_parser("create", help="Scaffold a new app from the template")
    p_create.add_argument("name", help="App name (slug)")
    p_create.add_argument(
        "--multi", action="store_true",
        help="Create a multi-service app structure without prompting"
    )

    p_build = sub.add_parser("build", help="Build app Docker image(s) locally")
    p_build.add_argument("name", help="App name")
    p_build.add_argument("--service", metavar="SERVICE", help="Build only this service")
    p_build.add_argument("--tag", metavar="TAG", default="local", help="Image tag (default: local)")
    p_build.add_argument("--registry", metavar="REGISTRY", help="Registry prefix (e.g. ghcr.io/owner)")

    args = parser.parse_args()
    dispatch = {"list": cmd_list, "validate": cmd_validate, "create": cmd_create, "build": cmd_build}
    return dispatch[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
